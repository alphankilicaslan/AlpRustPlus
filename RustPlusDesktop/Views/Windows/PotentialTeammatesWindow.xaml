<ui:FluentWindow x:Class="RustPlusDesk.Views.Windows.PotentialTeammatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:services="clr-namespace:RustPlusDesk.Services"
        Title="Olası Takım Arkadaşları (Steam / Klan)"
        Width="700" Height="680"
        MinWidth="550" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Foreground="White"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Olası Takım Arkadaşları (Steam / Klan)" ShowMaximize="True" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="20,8,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Target Player Header Card -->
            <Border Grid.Row="0" 
                    Background="#16181D" 
                    BorderBrush="#252A32" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14" 
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#21262D" Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="22" Foreground="#58A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtTargetName" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <Border x:Name="BadgeTargetGroup" Background="#30363D" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTargetGroup" FontSize="11" FontWeight="SemiBold" Foreground="#FFD166"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtTargetSteamId" FontSize="11" Foreground="#8B949E" Margin="0,2,0,0" FontFamily="Consolas, Segoe UI"/>
                        <TextBlock x:Name="TxtSummaryStats" FontSize="11" Foreground="#58A6FF" Margin="0,4,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Top Quick Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnAddAllRust" 
                                   Content="⚡ Rust'takileri Gruba Ekle" 
                                   Appearance="Primary" 
                                   Padding="10,6" 
                                   Margin="0,0,8,0"
                                   Click="BtnAddAllRust_Click"/>
                        <ui:Button x:Name="BtnRefresh" 
                                   Icon="ArrowClockwise24" 
                                   Appearance="Secondary" 
                                   Padding="8,6" 
                                   ToolTip="Listeyi Yenile"
                                   Click="BtnRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search and Filter Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtFilter" 
                            Grid.Column="0" 
                            PlaceholderText="Arkadaş ismi veya Steam ID ile filtrele..." 
                            Icon="Search24"
                            TextChanged="TxtFilter_TextChanged"/>
                <ui:Button x:Name="BtnAddAll" 
                           Grid.Column="1" 
                           Content="➕ Tümünü Gruba Ekle" 
                           Appearance="Secondary" 
                           Margin="8,0,0,0" 
                           Padding="10,6"
                           Click="BtnAddAll_Click"/>
            </Grid>

            <!-- Loading Indicator -->
            <StackPanel x:Name="PanelLoading" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" Margin="0,0,0,12"/>
                <TextBlock Text="Steam arkadaş listesi ve olası takım arkadaşları taranıyor..." Foreground="#8B949E" FontSize="13" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Private / Empty Notice -->
            <Border x:Name="PanelPrivateNotice" 
                    Grid.Row="3" 
                    Background="#1E1914" 
                    BorderBrush="#3D2D1B" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20" 
                    Margin="0,10,0,0" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    MaxWidth="520" 
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" Foreground="#D29922" Margin="0,0,8,0"/>
                        <TextBlock Text="Steam Arkadaş Listesi Gizli (Private)" FontSize="15" FontWeight="Bold" Foreground="#D29922"/>
                    </StackPanel>
                    <TextBlock Text="Bu oyuncunun Steam profilinde arkadaş listesi gizli olarak ayarlanmış. Bu nedenle Steam arkadaşları doğrudan listelenemedi." 
                               TextWrapping="Wrap" 
                               Foreground="#C9D1D9" 
                               FontSize="12" 
                               TextAlignment="Center" 
                               Margin="0,0,0,10"/>
                    <TextBlock Text="💡 İpucu: Bu oyuncuyla aynı grupta veya komşulukta takip ettiğiniz diğer kişilerin (örneğin diğer grup üyelerinin) arkadaşlarını tarayarak ortak bağlantıları yakalayabilirsiniz." 
                               TextWrapping="Wrap" 
                               Foreground="#8B949E" 
                               FontSize="11" 
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Teammates List -->
            <ListBox x:Name="ListTeammates" 
                     Grid.Row="3" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type services:PotentialTeammate}">
                        <Border Background="#14171C" 
                                BorderBrush="#20242B" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#21262D" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border.Clip>
                                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                    </Border.Clip>
                                    <Image Source="{Binding AvatarUrl}" Width="40" Height="40" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Info & Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="{Binding StatusBadgeColor}">
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SteamId, StringFormat='Steam ID: {0}'}" FontSize="11" Foreground="#8B949E" Margin="0,3,0,0" FontFamily="Consolas, Segoe UI"/>
                                </StackPanel>

                                <!-- Action Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExistingGroupName, StringFormat='✓ Takipte ({0})'}" 
                                               Foreground="#FFD166" 
                                               FontWeight="SemiBold" 
                                               FontSize="11" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,8,0"
                                               Visibility="{Binding IsAlreadyTracked, Converter={StaticResource Vis}}"/>
                                    <ui:Button Content="➕ Gruba Ekle" 
                                               Appearance="Primary" 
                                               Padding="8,4" 
                                               FontSize="11"
                                               Tag="{Binding}"
                                               Click="BtnAddSingle_Click"
                                               Visibility="{Binding IsAlreadyTracked, Converter={StaticResource Not}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </Grid>
</ui:FluentWindow>
